#:% name = Row Operations
#:% type = Sample
#:% subject = linear algebra
#:% categories = [matrix, row operation]
DOCUMENT()
#:% section = setup
#: Construct a matrix with three distinct rows. Create a string `$op` of Tex
#: code that describes the row operation. Use `$A->row(i)` to extract the ith
#: row of the matrix A as a MathObject. Use `$A->row(1) + $k * $A->row(2)` to
#: perform the row operation and place it into the first row of the answer
#: matrix.
#:
#: The do/until loop ensures that no two rows are identical.  This is not
#: necessary for this problem, but can be helpful in other situations.
Context('Matrix')
while True:
    A = Matrix([ [ non_zero_random(-5, 5), non_zero_random(-5, 5) ], [ non_zero_random(-5, 5), non_zero_random(-5, 5) ], [ non_zero_random(-5, 5), non_zero_random(-5, 5) ], ])
    if ((A.row(1):
        break
k = random(2, 9)
op = f"R_{{1}} + {k} R_{{2}} \\rightarrow R_{{1}}"
ans = Matrix([ A.row(1) + k * (A.row(2)), A.row(2), A.row(3), ])
#:% section = statement
#: Remember to append a `*` to use an array answer rule in PGML.
pgml_block_0 = '''
Give the result of applying the row operation [`[$op]`] to the given matrix.

[``[$A] \\mathop{\\longrightarrow}^{[op]}``] [_____]*{ans}
'''
TEXT(PGML(pgml_block_0))
#:% section = solution
pgml_block_1 = '''
Solution explanation goes here.
'''
SOLUTION(PGML(pgml_block_1))
ENDDOCUMENT()