## KEYWORDS('parametric', 'curve in space')
#:% name = Space Curve
#:% type = Sample
#:% subject = [parametric, vector calculus]
#:% section = preamble
DOCUMENT()
showPartialCorrectAnswers = 0
#:% section = setup
#: The PODLINK('parserMultiAnswer.pl') is used to check the answers together
#: since they are interdependent.
#:
#: The option `singleResult => 1` is used since it doesn't make sense to say
#: that `x(t)` is correct but `z(t)` is incorrect since they depend on one
#: another.
#:
#: The checker first ensures that the student has not given a bogus constant
#: solution such as `x = y = z = 0` by requiring the `x`-coordinate to be a
#: non-constant formula via
#:
#: ```{.perl}
#: return 0 unless $xstu->isFormula;
#: ```
#:
#: Then, it checks that the student answers satisfy the curve equation.
Context().variables.are(t = 'Real')
Context().variables.set(t = { 'limits' :  [ 0, 10 ] })
a = random((-5), (-2))
x = Formula(f"{a} * t^2")
y = Formula('0')
z = Formula('t')
multians = MultiAnswer(x, y, z).with_params( singleResult = 1, checker = lambda *args, **kwargs: None )  # Stubbed Perl closure
#:% section = statement
#: Notice that `$multians` is used for the answer for all answer rules.
pgml_block_0 = '''
Find a parametrization of the curve [`x = [$a]z^2`] in the [`xz`]-plane.  Use
[`t`] for the parameter.

[`x(t) =`] [_]{multians}{15}

[`y(t) =`] [_]{multians}{15}

[`z(t) =`] [_]{multians}{15}
'''
TEXT(PGML(pgml_block_0))
#:% section = solution
pgml_block_1 = '''
Solution explanation goes here.
'''
SOLUTION(PGML(pgml_block_1))
ENDDOCUMENT()