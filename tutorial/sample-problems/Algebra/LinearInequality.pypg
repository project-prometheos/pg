## DESCRIPTION
## Enter a linear inequality based on a description
## ENDDESCRIPTION
## DBsubject(WeBWorK)
## DBchapter(WeBWorK tutorial)
## DBsection(PGML tutorial 2015)
## Date(06/01/2023)
## Institution(Fitchburg State University)
## Author(Peter Staab)
## MO(1)
## KEYWORDS('algebra', 'linear inequality')
#:% name = Linear Inequality
#:% type = Sample
#:% subject = [algebra, precalculus]
#:% categories = [inequality]
#:% section = preamble
#: The macro file PODLINK('parserLinearRelation.pl') must be loaded to be able
#: to use the LinearRelation object.
DOCUMENT()
#:% section = setup
Context("LinearRelation")
while True:
    a = random(2, 6)
    b = random(2, 6)
    if (a != b):
        break
ab = a * b
lr = LinearRelation(f"{a} x + {b} y < {ab}").reduce
#:% section = statement
pgml_block_0 = '''
The line [`L`] that passes through the point [`([$b],0)`] and [`(0,[$a])`]
divides the [`xy`]-plane into two regions.  What is the linear relation that
describes the half-plane containing the origin?  Note, do not include the points
on the line?

[__]{lr}
'''
TEXT(PGML(pgml_block_0))
#:% section = solution
pgml_block_1 = '''
[`[$lr]`]
'''
SOLUTION(PGML(pgml_block_1))
ENDDOCUMENT()