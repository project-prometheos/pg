## MO(1)
## KEYWORDS('algebra', 'answer is any solution to an equation')
#:% name = Solution for an Equation
#:% type = Sample
#:% subject = [algebra, precalculus]
#:% categories = [equations]
#:% section = preamble
#: Load the macro PODLINK('parserSolutionFor.pl') for the `SolutionFor` method.
DOCUMENT()
#:% section = setup
#: `SolutionFor(equation, point)` is used to define the MathObject answer. For
#: more details and options, see PODLINK('parserSolutionFor.pl').
Context('Vector')
r = random(3, 6)
answer = SolutionFor(f"x^2 + y^2 + z^2 = {r}^2", [ r, 0, 0 ])
eqn = answer['f']
#:% section = statement
pgml_block_0 = '''
A solution to the equation [`[$eqn]`] is [`(x, y, z) =`] [_]{answer}{15}
'''
TEXT(PGML(pgml_block_0))
#:% section = solution
pgml_block_1 = '''
Solution explanation goes here.
'''
SOLUTION(PGML(pgml_block_1))
ENDDOCUMENT()