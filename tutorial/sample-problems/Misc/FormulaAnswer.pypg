#:% name = Formula Answer
#:% type = Sample
#:% subject = [algebra, precalculus]
#:% categories = [answers]
#:% section = preamble
DOCUMENT()
#:% section = setup
#: Use `do { $b = random(2, 9) } until $b != $a` to generate distinct random
#: numbers.
a = non_zero_random((-9), 9)
while True:
    b = random(2, 9)
    if ((b != a)):
        break
answer1 = Compute(f"{a}")
answer2 = Compute(f"({a} x^({b}) + {b})/x").reduce
#:% section = statement
pgml_block_0 = '''
Enter [`[$answer1]`]: [____]{answer1}

Enter [``[$answer2]``]: [____]{answer2}
'''
TEXT(PGML(pgml_block_0))
#:% section = solution
pgml_block_1 = '''
Solution explanation goes here.
'''
SOLUTION(PGML(pgml_block_1))
ENDDOCUMENT()