#:% name = Periodic Answers
#:% type = Sample
#:% subject = [trigonometry, precalculus]
#:% categories = [answers, trigonometry]
#:% section = preamble
DOCUMENT()
#:% section = setup
#: This allows any answer of the form `pi / 2 + n pi` where `n` is a particular
#: integer to be accepted.
answer = Real('pi / 2').with_params(period = pi)
#:% section = statement
pgml_block_0 = '''
Enter a solution to [`\\cos(\\theta) = 0`].

[`\\theta =`] [_]{answer}{15}
'''
TEXT(PGML(pgml_block_0))
#:% section = hint
#: A hint is provided.
pgml_block_1 = '''
The cosine of an angle is zero when the angle is [`\\frac{2n + 1}{2}\\pi`] for
any integer [`n`].
'''
HINT(PGML(pgml_block_1))
#:% section = solution
pgml_block_2 = '''
Solution explanation goes here.
'''
SOLUTION(PGML(pgml_block_2))
ENDDOCUMENT()