## Problem with solution and hint
DOCUMENT();

loadMacros("PG.pl", "PGstandard.pl", "PGbasicmacros.pl");

TEXT(beginproblem());

$a = random(10, 20, 1);
$b = random(2, 9, 1);
$answer = $a + $b;

BEGIN_TEXT
$PAR
Calculate \($a + $b\).
$PAR
Answer: \{ans_rule(10)\}
END_TEXT

ANS(num_cmp($answer));

BEGIN_HINT
$PAR
$BBOLD Hint: $EBOLD Add the two numbers together.
END_HINT

BEGIN_SOLUTION
$PAR
$BBOLD Solution: $EBOLD
$PAR
\($a + $b = $answer\)
END_SOLUTION

ENDDOCUMENT();
