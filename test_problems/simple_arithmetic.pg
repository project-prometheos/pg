## Simple arithmetic problem - traditional syntax
DOCUMENT();

loadMacros("PG.pl", "PGstandard.pl", "PGbasicmacros.pl");

TEXT(beginproblem());

$a = random(2, 9, 1);
$b = random(2, 9, 1);
$answer = $a + $b;

BEGIN_TEXT
$PAR
What is \($a + $b\)?
$PAR
Answer: \{ans_rule(10)\}
END_TEXT

ANS(num_cmp($answer));

ENDDOCUMENT();
