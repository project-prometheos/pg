# Existing PG ignores
*~
*.swp
*.bak

conf/pg_config.yml
cover_db/

htdocs/node_modules
htdocs/static-assets.json
htdocs/**/*.min.js
htdocs/**/*.min.css

# Monorepo tooling
node_modules/
.nx/
.pnp.cjs
.pnp.loader.mjs
pnpm-lock.yaml

# Python caches
__pycache__/
.venv/
.env
uv.lock

# Editors
.idea/
.vscode/
.DS_Store

# Testing artifacts
apps/backend/.pytest_cache/
coverage/
dist/

# Debugging and analysis scripts (development artifacts - root only)
# These patterns only apply to the root directory, not to test/ or tests/ subdirectories
debug_*.py
analyze_*.py
show_*.py
check_*.py
find_*.py
