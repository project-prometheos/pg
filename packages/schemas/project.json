{
  "name": "schemas",
  "root": "packages/schemas",
  "projectType": "library",
  "sourceRoot": "packages/schemas/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir packages/schemas build"
      },
      "outputs": ["{projectRoot}/dist"]
