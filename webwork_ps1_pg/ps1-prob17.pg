DOCUMENT(); loadMacros("PGstandard.pl","MathObjects.pl","PGML.pl"); TEXT(beginproblem());
Context("Numeric");
$A = Compute("pi/6"); $B = Compute("7pi/6");
BEGIN_PGML
**Problem 17.** Bestäm alla lösningar till \(\tan(x)=1/\sqrt3\) i \([0,2\pi[\). Växande ordning:
\([\,\_\,] \le [\,\_\,]\).

[_]{$A} <= [_]{$B}
END_PGML
ENDDOCUMENT();
