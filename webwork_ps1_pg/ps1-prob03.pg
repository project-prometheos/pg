DOCUMENT(); loadMacros("PGstandard.pl","MathObjects.pl","PGML.pl"); TEXT(beginproblem());
Context("Numeric");
$A = Compute("pi/6"); $B = Compute("11pi/6");
BEGIN_PGML
**Problem 3.** Bestäm alla lösningar till \(\cos(x)=\sqrt3/2\) i \([0,2\pi[\). Växande ordning:
\([\,\_\,] \le [\,\_\,]\).

[_]{$A} <= [_]{$B}
END_PGML
ENDDOCUMENT();
